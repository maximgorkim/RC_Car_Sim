<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="my_map_model">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      
      <!-- Visual element with the map texture -->
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>27.15 22.15</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://my_map_model/materials/scripts</uri>
            <uri>model://my_map_model/materials/textures</uri>
            <name>MyMapMaterial</name>
          </script>
        </material>
      </visual>
      
      <!-- Collision element -->
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>27.15 22.15</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>