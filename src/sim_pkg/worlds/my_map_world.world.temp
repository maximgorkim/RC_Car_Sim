<?xml version="1.0"?> 

<sdf version="1.6">

	<world name="my_map_world">
	  	<gravity> 0.0 0.0 -9.8</gravity>

		<!-- Lighting -->
		<light type="point" name="light1">
			<pose> 		0 0 5 0 0 0 	</pose>
			<diffuse>	255 255 255 255	</diffuse>
			<specular> 	255 255 255 255	</specular>
			<attenuation>
				<range> 	30 		</range>
				<constant>   0.5 	</constant>
				<quadratic>  0.01 	</quadratic>
				<linear> 	 0 		</linear>
			</attenuation>
			<cast_shadows>true</cast_shadows>
		</light>

		<light type="point" name="light2">
			<pose> 		-10 -10 5 0 0 0 	</pose>
			<diffuse>	255 255 255 255	</diffuse>
			<specular> 	255 255 255 255	</specular>
			<attenuation>
				<range> 	30 		</range>
				<constant>   0.5 	</constant>
				<quadratic>  0.01 	</quadratic>
				<linear> 	 0 		</linear>
			</attenuation>
			<cast_shadows>true</cast_shadows>
		</light>

		<light type="point" name="light3">
			<pose> 		10 10 5 0 0 0 	</pose>
			<diffuse>	255 255 255 255	</diffuse>
			<specular> 	255 255 255 255	</specular>
			<attenuation>
				<range> 	30 		</range>
				<constant>   0.5 	</constant>
				<quadratic>  0.01 	</quadratic>
				<linear> 	 0 		</linear>
			</attenuation>
			<cast_shadows>true</cast_shadows>
		</light>

		<!-- Custom map model -->
		<include>
			<uri>model://my_map_model</uri>
			<!-- Position: origin + (map_size / 2) -->
			<!-- X: -13.2 + 27.15/2 = 0.375 -->
			<!-- Y: -15.3 + 22.15/2 = -4.225 -->
			<pose>0.375 -4.225 0 0 0 0</pose>
		</include>


